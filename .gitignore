# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual envs -- anchored to the repo root: an unanchored `env/` also matched src/sentinel/env/
# and kept the whole env-adapter package out of git.
/.venv/
/venv/
/env/

# Env / secrets
.env
.env.*
!.env.example

# Raw third-party datasets (e.g. ITBench-Lite snapshots, several GB). Only compacted fixture JSON
# under fixtures/incidents/ is committed -- see docs/tasks/itbench_converter_spec.md.
data/

# Run store / artifacts
*.duckdb
*.parquet
runs/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
# Intermediate build artifact of `make types` -- frontend/src/api/types.ts is the committed output.
frontend/schemas/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
