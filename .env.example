# Copy to .env (gitignored) and fill in. scripts/start_backend.ps1 loads it automatically.
# Without the key for the judge's provider, the LLM-judge / Combined verifiers fail closed (block
# everything); the rest of the system still runs offline.

# LLM judge (config/default.yaml: models.llm_judge_provider = groq). Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Only for the ReAct diagnosis agent (agent.kind=react) or a judge switched back to anthropic.
ANTHROPIC_API_KEY=
